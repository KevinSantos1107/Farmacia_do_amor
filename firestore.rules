rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── FUNÇÕES AUXILIARES DE SEGURANÇA ─────────────────────────────
    
    // Verifica se o usuário está autenticado no Firebase Auth (anônimo ou e-mail/senha)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica se o usuário é administrador APENAS por Custom Claims de role.
    // A verificação por e-mail genérico foi removida pois permitia que qualquer
    // conta Google autenticada fosse tratada como admin.
    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.role in ['super_admin', 'site_admin'];
    }

    // Valida vínculo de token de jogador (o token deve existir na coleção e bater com o player reivindicado)
    function isValidPlayerLinkLegacy(uid) {
      return request.auth.uid == uid &&
        exists(/databases/$(database)/documents/player_tokens/$(request.resource.data.tokenId)) &&
        get(/databases/$(database)/documents/player_tokens/$(request.resource.data.tokenId)).data.player == request.resource.data.player;
    }

    function isValidPlayerLinkSite(siteId, uid) {
      return request.auth.uid == uid &&
        exists(/databases/$(database)/documents/sites/$(siteId)/player_tokens/$(request.resource.data.tokenId)) &&
        get(/databases/$(database)/documents/sites/$(siteId)/player_tokens/$(request.resource.data.tokenId)).data.player == request.resource.data.player;
    }

    // ─── COLEÇÕES DE INTERAÇÃO DO CASAL / JOGADORES (RAIZ) ───────────

    // 1. Tokens de acesso dos jogadores
    match /player_tokens/{tokenId} {
      // Leitura individual permitida para validação inicial do link (?token=...)
      allow get: if true;
      // Listagem, criação e exclusão restritas exclusivamente a administradores
      allow list, write: if isAdmin();
    }

    // 2. Vínculo seguro entre UID anônima do jogador e token
    match /player_links/{uid} {
      allow read: if request.auth.uid == uid || isAdmin();
      allow write: if isValidPlayerLinkLegacy(uid);
    }

    // 3. Recordes dos Mini-games
    // Leitura pública (placar/ranking visível a todos).
    // Criação e atualização permitidas a qualquer usuário autenticado (anônimo ou não)
    // — os jogadores já passam pelo signInAnonymously no PlayerAuthInit.
    // Exclusão restrita a admin.
    match /game_records/{recordId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 4. Salas de sincronização e presença em tempo real (Sync Game)
    // Requer autenticação anônima para evitar abuso externo, mas permite
    // leitura/escrita aos jogadores que já fizeram signInAnonymously.
    match /sync_rooms/{roomId} {
      allow read, write: if isAuthenticated();
    }
    match /sync_presence/{roomId} {
      allow read, write: if isAuthenticated();
    }

    // 5. Devocional diário compartilhado (sessões, favoritos e metadados)
    // Requer autenticação anônima — os jogadores já fazem signInAnonymously.
    match /devotional_sessions/{date} {
      allow read, write: if isAuthenticated();
    }
    match /devotional_favorites/{favId} {
      allow read, write: if isAuthenticated();
    }
    match /devotional_meta/{playerId} {
      allow read, write: if isAuthenticated();
    }

    // ─── CONTEÚDO DO SITE NA RAIZ (LEITURA ABERTA / ESCRITA ADMIN) ────
    
    // Álbuns e fotos
    match /albums/{albumId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /album_photos/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Timeline dos momentos
    match /timeline/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Playlists e trilhas sonoras
    match /custom_playlists/{playlistId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /playlist_tracks/{trackId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Roleta
    match /wheels/{wheelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Mapa das estrelas
    match /starmap/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Retrospectivas
    match /retrospectives/{retroId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Quiz
    match /quiz_questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /quiz_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Jogo de palavras (perguntas e palavras cadastradas)
    match /word_game/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Configuração geral do site
    match /site_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fila de limpeza do Cloudinary
    match /cloudinary_deletions_queue/{queueId} {
      allow read, write: if isAdmin();
    }

    // ─── SUPORTE AO MODO MULTI-SITE (sites/{siteId}/...) ──────────────
    // Protege completamente caso VITE_DATA_LAYOUT=site seja ativado
    match /sites/{siteId} {
      allow read: if true;
      allow write: if isAdmin();

      // Coleções aninhadas sob o site
      match /player_tokens/{tokenId} {
        allow get: if true;
        allow list, write: if isAdmin();
      }

      match /player_links/{uid} {
        allow read: if request.auth.uid == uid || isAdmin();
        allow write: if isValidPlayerLinkSite(siteId, uid);
      }

      match /game_records/{recordId} {
        allow read: if true;
        allow create, update: if isAuthenticated();
        allow delete: if isAdmin();
      }

      match /sync_rooms/{roomId} {
        allow read, write: if isAuthenticated();
      }
      match /sync_presence/{roomId} {
        allow read, write: if isAuthenticated();
      }

      match /devotional_sessions/{date} {
        allow read, write: if isAuthenticated();
      }
      match /devotional_favorites/{favId} {
        allow read, write: if isAuthenticated();
      }
      match /devotional_meta/{playerId} {
        allow read, write: if isAuthenticated();
      }

      // Conteúdo estático/gerenciado sob o site
      match /{subcol}/{document=**} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
  }
}
