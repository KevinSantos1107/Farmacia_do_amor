# ==============================================================================
# Romantic Engine — Variáveis de Ambiente
# ==============================================================================
# Copie este arquivo para .env e preencha com as credenciais do seu projeto.
# NUNCA versione ou compartilhe arquivos .env contendo chaves reais.

# ------------------------------------------------------------------------------
# Firebase Web Client (Obrigatórias para execução do frontend)
# Obtidas em: Firebase Console -> Configurações do Projeto -> Seus aplicativos -> Configuração do SDK
# ------------------------------------------------------------------------------
# Chave de API da aplicação web no Firebase
VITE_FIREBASE_API_KEY=your-firebase-api-key

# Domínio de autenticação do Firebase (ex: your-project-id.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Identificador do projeto Firebase
VITE_FIREBASE_PROJECT_ID=your-project-id

# Bucket do Firebase Cloud Storage (ex: your-project-id.firebasestorage.app)
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# ID do remetente para mensagens/Cloud Messaging (Sender ID)
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id

# Identificador da aplicação web registrada no Firebase
VITE_FIREBASE_APP_ID=your-firebase-app-id

# ------------------------------------------------------------------------------
# Cloudinary (Obrigatórias para upload e entrega de fotos e faixas de áudio)
# Obtidas em: Cloudinary Dashboard -> Settings -> Access Keys e Upload Presets
# ------------------------------------------------------------------------------
# Nome da conta (Cloud Name) no Cloudinary
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Upload preset unsigned para uploads gerais no frontend
VITE_CLOUDINARY_UPLOAD_PRESET=your-general-upload-preset

# Upload preset unsigned específico para imagens e fotos dos álbuns
VITE_CLOUDINARY_IMAGE_PRESET=your-image-upload-preset

# Upload preset unsigned específico para faixas de música (áudio/vídeo)
VITE_CLOUDINARY_AUDIO_PRESET=your-audio-upload-preset

# ------------------------------------------------------------------------------
# Configurações do Site e Recursos Opcionais
# ------------------------------------------------------------------------------
# Identificador do documento do site no Firestore (opcional, fallback interno: meu-site)
VITE_SITE_ID=meu-site

# Layout de armazenamento do Firestore ('legacy' [padrão] ou 'site')
# ATENÇÃO CRÍTICA: NUNCA alterar para 'site' antes de reescrever firestore.rules!
VITE_DATA_LAYOUT=legacy

# URL pública absoluta do site para meta tags OpenGraph (ex: https://seu-dominio.vercel.app)
VITE_SITE_URL=

# Nome do site / casal para <title>, OpenGraph e manifesto PWA (ex: Kevin & Iara)
VITE_SITE_NAME=

# Descrição do site para meta description, OpenGraph e manifesto PWA
VITE_SITE_DESCRIPTION=

# Imagem de preview OpenGraph absoluta (opcional; se omitida e VITE_SITE_URL existir, usa <VITE_SITE_URL>/capa_principal.jpg)
VITE_SITE_OG_IMAGE=

# Modo offline/mock (apenas para testes locais isolados sem conexão com Firestore).
# Quando 'true', usa dados mockados de meu-site.ts e NUNCA lê nem grava no Firestore.
# Em DEV normal (npm run dev), mantenha 'false' para que a config venha do Firestore real.
VITE_USE_MOCK_DATA=false

# ------------------------------------------------------------------------------
# Variáveis de Servidor (Vercel Serverless Functions / Backend)
# NUNCA prefixe com VITE_. Estas variáveis NÃO são enviadas nem expostas ao navegador.
# Configure no painel da Vercel (Project Settings -> Environment Variables).
# ------------------------------------------------------------------------------
# Chave de API do Google Gemini (utilizada na Serverless Function /api/generate-quiz)
GEMINI_API_KEY=your-gemini-api-key

# ID do projeto Firebase (utilizado na validação do token JWT do usuário na Serverless Function)
FIREBASE_PROJECT_ID=your-project-id

# ------------------------------------------------------------------------------
# Credenciais Administrativas do Cloudinary (Apenas para scripts/cleanup-cloudinary.mjs)
# ------------------------------------------------------------------------------
# Chave de API de administração da conta Cloudinary (opcional, usada apenas em npm run cleanup)
CLOUDINARY_API_KEY=your-cloudinary-api-key

# Segredo de API de administração da conta Cloudinary (opcional, usada apenas em npm run cleanup)
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# E-mail do administrador inicial (usado pelos scripts seed.mjs e update_password.mjs)
ADMIN_EMAIL=

# Senha do administrador inicial (usada pelos scripts seed.mjs e update_password.mjs)
ADMIN_PASSWORD=
